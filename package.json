{
  "name": "ae-mcp",
  "version": "1.1.0",
  "description": "After Effects MCP server: lean tool list, ~100 hidden tools via ae_find_tool/ae_call, raw run_script, and a brand recipe library",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ae-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node scripts/test.mjs",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist",
    "prepare": "npm run build"
  },
  "keywords": [
    "after-effects",
    "mcp",
    "motion-graphics",
    "animation",
    "adobe"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "acorn": "^8.19.0",
    "tsx": "^4.23.1",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
